{
  "name": "onezerowallet",
  "version": "0.0.1",
  "private": true,
  "description": "Self-custodial multi-chain crypto wallet as a Telegram Mini App",
  "scripts": {
    "dev": "pnpm --filter @onezerowallet/miniapp dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @onezerowallet/miniapp test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "license-check": "node scripts/license-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm test:esm && pnpm -r --if-present build && pnpm format:check && pnpm audit --audit-level=high && pnpm license-check && pnpm e2e:install && pnpm test:e2e",
    "ci": "pnpm verify",
    "e2e:install": "pnpm --filter @onezerowallet/miniapp exec playwright install chromium webkit",
    "test:esm": "node scripts/esm-smoke.mjs"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "prettier": "^3.4.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
