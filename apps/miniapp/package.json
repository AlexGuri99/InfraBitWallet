{
  "name": "@onezerowallet/miniapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:libs && tsc --noEmit && vite build && node scripts/ensure-root-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint src/ api/",
    "type-check": "pnpm run build:libs && tsc --noEmit && tsc -p api --noEmit",
    "test": "pnpm run build:libs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:libs && playwright test",
    "build:libs": "pnpm --filter @onezerowallet/chain-ton build && pnpm --filter @onezerowallet/api build"
  },
  "dependencies": {
    "@onezerowallet/api": "workspace:*",
    "@onezerowallet/chain-ton": "workspace:*",
    "@onezerowallet/core": "workspace:*",
    "@onezerowallet/crypto-vault": "workspace:*",
    "@telegram-apps/sdk": "^3.11.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
