# Server-only configuration for the OneZeroWallet API service.
# Copy to `.env.local` (gitignored) for local development, and set the same names in
# Vercel -> Project -> Settings -> Environment Variables for deployments.
#
# NEVER put these in the Mini App, in any VITE_* variable, in a URL, or in chat/logs:
# the Mini App is a static bundle and every VITE_* value is public.

# Which TON data provider the API service uses: toncenter | tonapi
TON_DATA_PROVIDER=toncenter

# TON Center (https://toncenter.com/api/v3) — sent as the X-API-Key header.
TONCENTER_API_KEY=

# TonAPI (https://tonapi.io) — sent as Authorization: Bearer <key>.
TONAPI_API_KEY=
